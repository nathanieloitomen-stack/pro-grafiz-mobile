# Copy to .env.local (or platform-specific env config) per environment.
# Never commit an actual .env file — see .gitignore.
# Values below are placeholders, not real credentials.

# --- Environment ---
APP_ENV=local   # local | development | staging | production

# --- Supabase ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=   # server-side only, never shipped to mobile/web clients

# --- Supabase (admin-web browser client — Next.js requires the NEXT_PUBLIC_ prefix
# to expose a value to browser code; these are the same URL/anon key as above,
# just re-exposed under the name Next.js will actually read) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- SMS provider (customer phone OTP — see supabase/config.toml [auth.sms]) ---
# No vendor chosen yet; this is illustrative of what a provider like
# Twilio needs, not a commitment to Twilio specifically.
SMS_PROVIDER_ACCOUNT_SID=
SMS_PROVIDER_AUTH_TOKEN=
SMS_PROVIDER_SENDER_ID=

# --- Payments (provider adapter — set one; finalize choice before PG-009) ---
PAYSTACK_SECRET_KEY=
FLUTTERWAVE_SECRET_KEY=

# --- Notifications ---
FIREBASE_SERVER_KEY=

# --- Messaging ---
WHATSAPP_BUSINESS_API_TOKEN=

# --- Monitoring ---
SENTRY_DSN=
