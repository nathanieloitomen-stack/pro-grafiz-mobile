# Secrets — never commit
.env
.env.*
!.env.example
*.pem
*.key
**/service-account*.json

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# Node (admin-web, backend tooling)
node_modules/
.next/
out/
dist/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Flutter / Dart (mobile)
apps/mobile/.dart_tool/
apps/mobile/.flutter-plugins
apps/mobile/.flutter-plugins-dependencies
apps/mobile/.packages
apps/mobile/build/
apps/mobile/.pub-cache/
apps/mobile/.pub/
apps/mobile/**/ios/Pods/
apps/mobile/**/ios/.symlinks/
apps/mobile/**/android/.gradle/
apps/mobile/**/android/local.properties

# Python (cad-engine)
cad-engine/__pycache__/
cad-engine/*.pyc
cad-engine/.venv/
cad-engine/venv/

# Supabase local
supabase/.branches/
supabase/.temp/

# Production customer files / private assets — never committed regardless of source
**/private-uploads/
**/customer-files/
